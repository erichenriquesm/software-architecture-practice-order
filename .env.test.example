# Ephemeral containers of docker-compose.test.yml. Copy to .env.test: cp .env.test.example .env.test
POSTGRES_PASSWORD=test
RABBITMQ_DEFAULT_USER=test
RABBITMQ_DEFAULT_PASS=test
TEST_DATABASE_URL=postgres://postgres:test@order-db-test:5432/postgres
TEST_RABBITMQ_URL=amqp://test:test@order-rabbitmq-test:5672
TEST_REDIS_URL=redis://order-redis-test:6379

# Public half of the dev Ed25519 pair that account signs user tokens with (PEM on one line, literal \n)
USER_TOKEN_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEALxCEnICerfG52kOtFCaYrwczs5XMniydqmd9Si/Pf2I=\n-----END PUBLIC KEY-----\n
